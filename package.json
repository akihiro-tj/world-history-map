{
  "name": "world-history-map",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "tokens": "tsx scripts/tokens.ts",
    "publish:assets": "tsx scripts/publish-assets.ts",
    "deploy:cf": "pnpm build && pnpm publish:assets && wrangler deploy",
    "preview:cf": "pnpm build && pnpm publish:assets && wrangler preview"
  },
  "dependencies": {
    "maplibre-gl": "6.11.0",
    "pmtiles": "4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/workers-types": "5.20260923.1",
    "@google/design.md": "0.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.136.3"
  }
}
